{
  "name": "darz",
  "version": "0.1.0",
  "description": "Read-only check of whether a GitHub repository's gate holds against AI coding agents.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "darz": "dist/bin.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
